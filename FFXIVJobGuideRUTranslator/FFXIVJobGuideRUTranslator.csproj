<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Morriganna</Author>
    <Name>FFXIV JobGuide RU Translator</Name>
    <Punchline>Заменяет описание умений на перевод с ff14jobguide.ru.</Punchline>
    <Description>Подменяет ТОЛЬКО текст описания умения (не название) во всплывающей подсказке умения
и в панели описания окна "Actions &amp; Traits" на русский перевод из проекта FFXIVJobGuideRU
(https://github.com/Murakumo-JP/FFXIVJobGuideRU, https://ff14jobguide.ru). Ничего больше в интерфейсе не трогает.</Description>
    <RepoUrl>https://github.com/Morriganna/FFXIVJobGuideRUTranslator</RepoUrl>
    <Tags>translation;russian;localization;actions</Tags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Бандл переводов из DB/*.json репозитория FFXIVJobGuideRU, скачанный на момент сборки.
         Компилируется прямо в DLL, поэтому плагину не нужен интернет, чтобы работать -
         только чтобы обновить перевод командой "/jgru update". -->
    <EmbeddedResource Include="Data\SourceJson\**\*.json" />
  </ItemGroup>

  <!-- Пакет KamiToolKit убран: попытка заменить родную подсказку умения собственным деревом нод
       (OverlayController/OverlayNode/TextNode) не прижилась - перенос текста не работал как
       нужно, видимость мигала. Заменено на нативный AtkStage.Instance()->TooltipManager из
       FFXIVClientStructs (уже приходит транзитивно через сам Dalamud.NET.Sdk, отдельный пакет не
       нужен) - см. Windows/NativeTooltipOverlay.cs. -->
</Project>
